<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentflow</groupId>
        <artifactId>agentflow-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>demo-api</artifactId>
    <name>AgentFlow Demo :: REST API</name>
    <description>可运行 REST API Server：把 agentflow-api 的 WorkflowController/TraceController/DiagnosisController + ApiKeyAuthFilter 接成可启动的 Spring Boot 应用，mock 模式零成本跑通「真实 API 优先」路径（UI demo 依赖后端可达）。</description>

    <dependencies>
        <dependency>
            <groupId>com.agentflow</groupId>
            <artifactId>agentflow-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentflow</groupId>
            <artifactId>agentflow-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 可观测性（Grafana/Prometheus）：暴露 /actuator/prometheus 供 Prometheus 抓取。
             AgentFlowMetrics（U7）注册的 5 指标族经 PrometheusMeterRegistry 输出（见 docs/GRAFANA.md）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- 跳过 JaCoCo 门禁：demo 模块是验证场景，核心引擎覆盖率由 core/adapters/api/starter 保证 -->
        <jacoco.skip>true</jacoco.skip>
    </properties>
</project>
