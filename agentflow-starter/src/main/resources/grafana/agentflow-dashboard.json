{
  "annotations": {
    "list": []
  },
  "description": "AgentFlow 可观测性总览（U7，R9/R10）。指标由 com.agentflow.observability.AgentFlowMetrics 注册（Micrometer → Prometheus 命名：点号转下划线，Counter 加 _total 后缀，Timer 以秒为单位）。本 dashboard 指标名对齐 AgentFlowMetrics 常量（agentflow.workflow.executed / node.duration / tokens.consumed / cost.estimated / cost.budget_exceeded）。数据源：Prometheus。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "工作流执行趋势（按状态）",
      "description": "Counter: agentflow.workflow.executed（tag: status=success/failed），BspEngine 在执行终结时记录。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (status) (rate(agentflow_workflow_executed_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "各 Agent 延迟 P50 / P95 / P99",
      "description": "Timer: agentflow.node.duration（tag: agent，含重试耗时，语义=节点从提交到终结）。AgentFlowMetrics.recordNodeDuration 开启 publishPercentileHistogram，暴露 _bucket 序列供 histogram_quantile 计算分位。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, agent) (rate(agentflow_node_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50 {{agent}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(agentflow_node_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95 {{agent}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, agent) (rate(agentflow_node_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P99 {{agent}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Token 消耗 Top 10（按 Agent）",
      "description": "Counter: agentflow.tokens.consumed（tag: agent, model），TokenCountingAdvisor 在真实 LLM 路径记录；mock 模式 token 记 0 不上榜。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100000 },
              { "color": "red", "value": 1000000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, sum by (agent) (increase(agentflow_tokens_consumed_total[$__range])))",
          "legendFormat": "{{agent}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM 成本估算（美元，按 Model）",
      "description": "Counter: agentflow.workflow.cost.estimated（美元，tag: model）= token × CostCalculator 单价表（agentflow-cost-pricings.json）。AgentFlowMetrics.recordTokens/recordCost 按 model 聚合；按 workflowId 拆分的单工作流成本留 v2。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (rate(agentflow_workflow_cost_estimated_total[$__rate_interval]))",
          "legendFormat": "{{model}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "预算超限次数 / 窗口内总成本",
      "description": "Counter: agentflow.workflow.cost.budget_exceeded（单次调用估算成本 > 预算阈值时 +1，阈值由 AgentFlowMetrics 配置）。红色 = 发生过超限。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "窗口内总成本" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "vertical",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(agentflow_workflow_cost_budget_exceeded_total[$__range]))",
          "legendFormat": "预算超限次数",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(agentflow_workflow_cost_estimated_total[$__range]))",
          "legendFormat": "窗口内总成本",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "工作流失败率",
      "description": "failed 执行速率 / 总执行速率（agentflow.workflow.executed，tag: status）。超过 5% 橙色、20% 红色。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(agentflow_workflow_executed_total{status=\"failed\"}[$__rate_interval])) / sum(rate(agentflow_workflow_executed_total[$__rate_interval]))",
          "legendFormat": "失败率",
          "range": true
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["agentflow", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus 数据源",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AgentFlow 可观测性总览",
  "uid": "agentflow-observability",
  "version": 1,
  "weekStart": ""
}
