<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentflow</groupId>
        <artifactId>agentflow-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>demo-rag</artifactId>
    <name>AgentFlow Demo :: RAG 检索增强（KTD-6 零改动证明）</name>
    <description>验证引擎层零改动、Agent 扩展点成立：agent: rag 走「检索 → 增强 → 委托」全流程（RAG 加分项）。</description>

    <dependencies>
        <dependency>
            <groupId>com.agentflow</groupId>
            <artifactId>agentflow-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentflow</groupId>
            <artifactId>agentflow-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentflow</groupId>
            <artifactId>agentflow-adapters-spring-ai</artifactId>
        </dependency>
        <!-- 真实 LLM 委托（agentflow.rag.real.* 门控）：OpenAI 兼容 → DeepSeek，阿里 demo-api 生产接线同款 -->
        <dependency>
            <groupId>com.agentflow</groupId>
            <artifactId>agentflow-adapters-langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- 跳过 JaCoCo 门禁：demo 模块是验证场景，核心引擎覆盖率由 core/adapters/api/starter 保证 -->
        <jacoco.skip>true</jacoco.skip>
    </properties>
</project>